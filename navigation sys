from collections import deque

graph = {}

def add_place(a):
    if a not in graph:
        graph[a] = []

def connect(a, b):
    add_place(a)
    add_place(b)

    if b not in graph[a]:
        graph[a].append(b)

    if a not in graph[b]:
        graph[b].append(a)


def find_route(start, end):
    queue = deque()
    queue.append([start])
    visited = set()

    while queue:
        path = queue.popleft()
        node = path[-1]

        if node == end:
            return path

        if node not in visited:
            visited.add(node)

            for neighbor in graph[node]:
                new_path = list(path)
                new_path.append(neighbor)
                queue.append(new_path)

    return None


while True:
    print("\n1 Добавить дорогу")
    print("2 Найти маршрут")
    print("3 Показать карту")
    print("4 Выход")

    choice = input("Выбери: ")

    if choice == "1":
        a = input("Точка 1: ")
        b = input("Точка 2: ")
        connect(a, b)

    elif choice == "2":
        start = input("Откуда: ")
        end = input("Куда: ")

        if start in graph and end in graph:
            route = find_route(start, end)

            if route:
                print("Маршрут:", " -> ".join(route))
            else:
                print("Маршрут не найден")
        else:
            print("Нет таких точек")

    elif choice == "3":
        for place in graph:
            print(place, "->", graph[place])

    elif choice == "4":
        break

    else:
        print("Ошибка")
