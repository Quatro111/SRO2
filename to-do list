tasks = []

while True:
    print("\n1 Добавить задачу")
    print("2 Удалить задачу")
    print("3 Показать задачи")
    print("4 Выход")

    choice = input("Выбери: ")

    if choice == "1":
        task = input("Введите задачу: ")
        tasks.append(task)

    elif choice == "2":
        task = input("Введите задачу для удаления: ")
        if task in tasks:
            tasks.remove(task)
        else:
            print("Задача не найдена")

    elif choice == "3":
        if len(tasks) == 0:
            print("Список пуст")
        else:
            for i in range(len(tasks)):
                print(f"{i+1}. {tasks[i]}")

    elif choice == "4":
        break

    else:
        print("Ошибка")
