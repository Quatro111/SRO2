queue = []

while True:
    print("\n1 Добавить клиента")
    print("2 Обслужить клиента")
    print("3 Показать очередь")
    print("4 Выход")

    choice = input("Выбери: ")

    if choice == "1":
        name = input("Введите имя клиента: ")
        queue.append(name)

    elif choice == "2":
        if len(queue) == 0:
            print("Очередь пуста")
        else:
            print("Обслужен:", queue.pop(0))

    elif choice == "3":
        if len(queue) == 0:
            print("Очередь пуста")
        else:
            for i in range(len(queue)):
                print(f"{i+1}. {queue[i]}")

    elif choice == "4":
        break

    else:
        print("Ошибка")
